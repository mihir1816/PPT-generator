# ---- Database (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=teacher_content_gen
DB_USER=tcg_user
DB_PASSWORD=changeme

# ---- Redis-compatible broker/cache (Valkey) ----
REDIS_HOST=valkey
REDIS_PORT=6379

# ---- Vector DB (Qdrant) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---- File storage (MinIO) ----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=tcg-uploads

# ---- LLM inference (vLLM, OpenAI-compatible) ----
# Production target per project spec: Qwen/Qwen3-30B-A3B-AWQ (requires ~17GB VRAM)
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-AWQ
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_JSON_RETRIES=1

# vLLM container launch args (override for smaller GPUs during local dev)
VLLM_MODEL=Qwen/Qwen3-30B-A3B-AWQ
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.90
VLLM_DTYPE=half
HUGGING_FACE_HUB_TOKEN=

# ---- Embedding & Chunking ----
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
CHUNK_SIZE_CHILD=512
CHUNK_SIZE_PARENT=2048
CHUNK_OVERLAP=50
QDRANT_COLLECTION=tcg_chunks

# ---- Celery ----
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1

# ---- Misc ----
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:3000"]
